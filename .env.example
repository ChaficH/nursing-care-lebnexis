# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

POSTGRES_USER=lebnexis
POSTGRES_PASSWORD=lebnexis
POSTGRES_DB=lebnexis_db
POSTGRES_PORT=5432

BACKEND_PORT=3000
ML_PORT=8000

NODE_ENV=development

# Backend auth — GENERATE a strong random value for production.
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Optional pool tuning (defaults shown)
# PGPOOL_MAX=10
# DEBUG_SQL=false

# Optional: set a full connection string instead of individual PG vars.
# DATABASE_URL=postgres://lebnexis:lebnexis@localhost:5432/lebnexis_db

